* text=auto
*.kt text eol=lf
*.kts text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.sh text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.png binary
*.jpg binary
*.jar binary
*.apk binary
*.aar binary
# This source kit has byte-for-byte archive/provenance checks.
third-party/nextlib/** -text whitespace=cr-at-eol
third-party/nextlib/*.patch -whitespace
